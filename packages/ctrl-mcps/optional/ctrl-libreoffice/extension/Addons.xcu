<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data
  xmlns:oor="http://openoffice.org/2001/registry"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  oor:name="Addons"
  oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBar">
      <node oor:name="app.ctrl.libreoffice.companion.menubar" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">CTRL Companion</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.text.TextDocument;com.sun.star.sheet.SpreadsheetDocument</value>
        </prop>
        <node oor:name="Submenu">
          <node oor:name="enable" oor:op="replace">
            <prop oor:name="Title"><value xml:lang="en-US">Enable</value></prop>
            <prop oor:name="URL"><value>service:app.ctrl.libreoffice.Companion?enable</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
          <node oor:name="disable" oor:op="replace">
            <prop oor:name="Title"><value xml:lang="en-US">Disable</value></prop>
            <prop oor:name="URL"><value>service:app.ctrl.libreoffice.Companion?disable</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
